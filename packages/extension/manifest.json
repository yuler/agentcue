{
  "manifest_version": 3,
  "name": "agentcue — Visual UI Cues for Agent CLIs",
  "short_name": "agentcue",
  "version": "0.0.1",
  "description": "Pick DOM elements in the browser, jot down quick UI edits, and push Cues straight to your local Agent CLI (agy, claude, cursor-agent, codex, pi).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "action": {
    "default_title": "Toggle agentcue Pick Mode (Cmd/Ctrl+Shift+F)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle agentcue Pick Mode on the current tab"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
